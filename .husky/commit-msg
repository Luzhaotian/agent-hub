#!/bin/bash
# Git commit-msg hook: Conventional Commits + 中文描述

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# 去除注释和空行
TRIMMED=$(echo "$COMMIT_MSG" | sed '/^#/d' | sed '/^$/d')

# 格式: <type>: <中文描述>
PATTERN="^(feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert): .+"

# 规则 1: 格式必须正确
if ! echo "$TRIMMED" | grep -qE "$PATTERN"; then
    echo "❌ 提交信息格式错误"
    echo ""
    echo "   正确格式: <type>: <中文描述>"
    echo ""
    echo "   type 可选值:"
    echo "     feat     新功能"
    echo "     fix      修复 bug"
    echo "     chore    构建/工具链/杂项"
    echo "     docs     文档变更"
    echo "     style    代码格式（不影响功能）"
    echo "     refactor 重构"
    echo "     perf     性能优化"
    echo "     test     测试相关"
    echo "     build    构建系统或依赖变更"
    echo "     ci       CI 配置变更"
    echo "     revert   回退"
    echo ""
    echo "   示例: feat: 添加角色创建功能"
    exit 1
fi

# 提取描述部分（type: 之后的内容）
DESC=$(echo "$TRIMMED" | sed 's/^[^:]*: //')

# 规则 2: 描述不能为空
if [ -z "$DESC" ]; then
    echo "❌ 描述不能为空"
    exit 1
fi

# 规则 3: 描述必须包含中文
if ! echo "$DESC" | perl -CS -ne 'print if /\p{Han}/' | grep -q .; then
    echo "❌ 描述必须包含中文"
    exit 1
fi

# 规则 4: 末尾不能有句号
if echo "$DESC" | grep -q '。$'; then
    echo "❌ 描述末尾不能有句号"
    exit 1
fi

# 规则 5: 总长度 <= 50 字符
LENGTH=$(echo "$TRIMMED" | wc -c | tr -d ' ')
if [ "$LENGTH" -gt 50 ]; then
    echo "⚠️  警告: 提交信息超过 50 个字符 (当前 $LENGTH)，建议简短描述"
fi

exit 0
